# DOCUMENTACION, no auto-cargada por la app. Rellenar fuera de Git/solo Render staging.
# Los campos vacios son datos faltantes, NO secretos ni credenciales funcionales.
NODE_VERSION=24.16.0
NODE_ENV=production
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
ZENTRA_ALLOWED_ORIGINS=
USER_ACCESS_HAS_AUTH_USER_ID=true
ZENTRA_AUDIO_TRANSCRIPTION_ENABLED=false
ZENTRA_EXECUTIVE_REFINER_MAX_TOKENS=900
ZENTRA_CHAT_REASONING_MAX_TOKENS=1800
ZENTRA_CHAT_EXECUTIVE_ENABLED=false
ZENTRA_CHAT_EXECUTIVE_MAX_TOKENS=1200
# Necesarias para validar billing/Lemon; completar SOLO con configuracion test verificada.
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_WEBHOOK_SECRET=
LEMON_SQUEEZY_API_KEY=
LEMON_ALLOW_TEST_WEBHOOKS=true
# Opcionales: OPENAI_SEARCH_API_KEY (hereda OPENAI_API_KEY), ZENTRA_TRUSTED_PROXY_CIDRS.
# No poner variables de modelo: el routing GPT-6 esta fijado en codigo.
# ZENTRA_AUDIT_JSON_DEBUG=true requiere NODE_ENV != production; omitir normalmente.
